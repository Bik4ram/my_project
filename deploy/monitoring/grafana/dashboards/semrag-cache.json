      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cache hit rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(semrag_cache_hits_total[5m])) / (sum(rate(semrag_cache_hits_total[5m])) + sum(rate(semrag_cache_misses_total[5m])))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Cache events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(semrag_cache_hits_total[5m])) by (backend)",
          "legendFormat": "hits {{backend}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(semrag_cache_misses_total[5m])) by (backend)",
          "legendFormat": "misses {{backend}}",
          "refId": "B"
        },
        {
          "expr": "sum(rate(semrag_cache_evictions_total[5m])) by (backend)",
          "legendFormat": "evictions {{backend}}",
          "refId": "C"
        }
      ]
