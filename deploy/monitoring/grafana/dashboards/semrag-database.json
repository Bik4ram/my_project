{
  "annotations": { "list": [] },
  "description": "Wave 3 — Postgres query latency, transaction count, and connection pool.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "DB query latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (op, le) (rate(semrag_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "DB transactions / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(semrag_db_transactions_total[5m])) by (op)",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Connection pool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "semrag_db_pool_connections",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    }
  ],
