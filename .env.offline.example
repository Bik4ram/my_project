# SemRAG — fully-offline deployment environment template.
# Copy to .env on the offline machine and adjust. Never commit .env.
#
# This is the complete environment for a self-contained, no-Internet
# SemRAG + OpenCode + Ollama stack:
#   - LLM:     local Ollama, model qwen3-coder:30b (ONLY model used).
#   - Embeddings: local Ollama, model nomic-embed-text.
#   - Every endpoint is 127.0.0.1/localhost; nothing dials out.
#   - Indexing worker runs as a separate process (see start_offline.sh).
#
# Everything is prefixed with SEMRAG_ (see semrag.core.settings) except the
# two MCP-server variables, which are read directly by
# semrag_mcp_server.py.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector on this host)
# ---------------------------------------------------------------------------
SEMRAG_DATABASE_URL=postgresql+psycopg2://semrag:semrag@localhost:5432/semrag
SEMRAG_DB_POOL_SIZE=5
SEMRAG_DB_MAX_OVERFLOW=10
SEMRAG_DB_POOL_RECYCLE=300
SEMRAG_DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Logging / observability
# ---------------------------------------------------------------------------
SEMRAG_LOG_LEVEL=INFO
SEMRAG_LOG_FORMAT=human
SEMRAG_DEBUG_ARTIFACTS_DIR=./.semrag/debug
SEMRAG_DEBUG_ARTIFACT_RETENTION=5

# ---------------------------------------------------------------------------
# Embedding provider (local Ollama; ONLY nomic-embed-text)
# ---------------------------------------------------------------------------
SEMRAG_EMBEDDING_PROVIDER=ollama
SEMRAG_EMBEDDING_MODEL=nomic-embed-text
SEMRAG_EMBEDDING_DIMENSION=768
SEMRAG_EMBEDDING_BASE_URL=http://localhost:11434
SEMRAG_EMBEDDING_API_KEY=
SEMRAG_EMBEDDING_TIMEOUT_SECONDS=300
SEMRAG_EMBEDDING_CACHE_DIR=./.embedding_cache
SEMRAG_EMBEDDING_CACHE_BACKEND=jsonfile
SEMRAG_EMBEDDING_PROVIDER_DIR=/tmp/semrag_embedding_providers

# ---------------------------------------------------------------------------
# LLM provider (local Ollama; ONLY qwen3-coder:30b)
# ---------------------------------------------------------------------------
SEMRAG_LLM_PROVIDER=ollama
SEMRAG_LLM_MODEL=qwen3-coder:30b
SEMRAG_LLM_BASE_URL=http://localhost:11434
SEMRAG_LLM_API_KEY=
# 1800s: a 30B-class thinking + answer generation takes minutes.
SEMRAG_LLM_TIMEOUT_SECONDS=1800
SEMRAG_LLM_MAX_RETRIES=2
SEMRAG_LLM_MAX_ITERATIONS=8
SEMRAG_LLM_CONTEXT_WINDOW=8192
SEMRAG_LLM_RESERVED_FOR_RESPONSE=1024
# 8192: thinking phase + Plan-1 + Plan-2 JSON in one call.
SEMRAG_LLM_NUM_PREDICT=8192
SEMRAG_LLM_OLLAMA_THINK=true
SEMRAG_LLM_PROBE_AT_STARTUP=true

# ---------------------------------------------------------------------------
# Validation (portable external dependencies)
# ---------------------------------------------------------------------------
# Absolute path to the UVM library source tree used by validation targets.
# The start scripts export this so the API/worker processes see it.
SEMRAG_UVM_ROOT=/home/you/projects/uvm-core/src

# ---------------------------------------------------------------------------
# Project paths (portable multi-root configuration)
# ---------------------------------------------------------------------------
# Authoritative roots for the RTL, testbench, and documentation areas. They
# are independent and need NOT share a parent directory. When any of the
# three is set, the backend operates on that project context and resolves
# the active project from the caller's working directory (see
# docs/PROJECT_ROOT_CONFIGURATION.md). SEMRAG_PROJECT_ID gives the project
# an explicit logical id.
# SEMRAG_RTL_ROOT=/home/you/projects/my-chip/rtl
# SEMRAG_TB_ROOT=/home/you/projects/my-chip-tb
# SEMRAG_DOCS_ROOT=/home/you/projects/my-chip-docs
# SEMRAG_PROJECT_ID=my-chip

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
SEMRAG_VECTOR_TOP_K=20
SEMRAG_LEXICAL_TOP_K=20
SEMRAG_FINAL_TOP_K=10
SEMRAG_RERANKER=lexical_overlap
SEMRAG_ENABLE_GRAPH_EXPANSION=true
SEMRAG_GRAPH_EXPANSION_MAX_DEPTH=1
SEMRAG_GRAPH_EXPANSION_MAX_PER_RESULT=3
SEMRAG_RRF_K=60
SEMRAG_ENABLE_INTENT_BOOST=true
SEMRAG_NOISY_SOURCE_PATH_TERMS=/log/
SEMRAG_NOISY_SOURCE_PENALTY=0.4
SEMRAG_RETRIEVAL_DOC_TYPE_PRIOR_ENABLED=true
SEMRAG_SOURCE_AUTHORITY_OVERRIDES=
SEMRAG_SOURCE_AUTHORITY_MAX_BOOST=
SEMRAG_RETRIEVAL_DIVERSITY_ENABLED=true
SEMRAG_RETRIEVAL_DIVERSITY_MAX_PER_FILE=3
SEMRAG_RETRIEVAL_DIVERSITY_MAX_PER_CATEGORY=6
SEMRAG_RETRIEVAL_DIVERSITY_NEIGHBOUR_WINDOW=25
SEMRAG_RETRIEVAL_DIVERSITY_POOL_MULTIPLIER=2
SEMRAG_QUERY_EXPANSION_ENABLED=true
SEMRAG_QUERY_EXPANSION_MAX_EXPANSIONS=3
SEMRAG_QUERY_EXPANSION_MAX_EXPANSION_LENGTH=80
SEMRAG_QUERY_EXPANSION_TIMEOUT_MS=
SEMRAG_RETRIEVAL_RERANK_METADATA_TIEBREAK=true
SEMRAG_RETRIEVAL_RERANK_NEAR_TIE_EPSILON=0.0001

# --- Worker / jobs ---
# Offline production pattern: the API does NOT run an in-process worker;
# start_offline.sh starts `python -m semrag.worker` separately.
SEMRAG_API_RUNS_WORKER=false
SEMRAG_JOB_STORE_BACKEND=database
SEMRAG_WORKER_POLL_INTERVAL_SECONDS=1.0

# --- Redis (unused in the default offline config; keep empty) ---
SEMRAG_REDIS_URL=

# ---------------------------------------------------------------------------
# Observability (metrics stay local; tracing disabled so nothing dials out)
# ---------------------------------------------------------------------------
SEMRAG_METRICS_ENABLED=true
SEMRAG_METRICS_PATH=/metrics
SEMRAG_TRACING_ENABLED=false
SEMRAG_OTLP_ENDPOINT=http://localhost:4317
SEMRAG_OTEL_SERVICE_NAME=semrag
SEMRAG_TRACE_SAMPLE_RATIO=1.0
SEMRAG_LOG_EXCEPTIONS=true
SEMRAG_LOG_MAX_PAYLOAD_CHARS=4096

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Generate a real key for the offline deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SEMRAG_API_KEYS=dev-local-key
SEMRAG_RATE_LIMIT_PER_MINUTE=60
SEMRAG_QUERY_CACHE_TTL_SECONDS=300
SEMRAG_QUERY_CACHE_BACKEND=memory

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SEMRAG_ENVIRONMENT=development
SEMRAG_TRUSTED_HOSTS=127.0.0.1,localhost
SEMRAG_CORS_ORIGINS=http://localhost:3000
SEMRAG_MAX_BODY_SIZE=5242880
SEMRAG_ENABLE_GZIP=false
SEMRAG_SECURITY_HEADERS=
SEMRAG_API_KEY_STORE=memory
SEMRAG_RATE_LIMIT_BACKEND=memory
SEMRAG_PROJECT_ROOTS=
SEMRAG_API_KEY_EXPIRE_DAYS=30
SEMRAG_REJECT_DEV_KEYS_IN_PRODUCTION=true

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------
SEMRAG_MAX_CONCURRENT_PARSE_WORKERS=4
SEMRAG_MAX_CONCURRENT_HASH_WORKERS=8

# ---------------------------------------------------------------------------
# MCP server (read by semrag_mcp_server.py, NOT by semrag.core.settings)
# ---------------------------------------------------------------------------
# Per-request HTTP timeout for MCP -> API calls. Long coding-agent
# workflows on a 30B-class model routinely exceed 10 minutes; 7200s (2h)
# keeps semrag_code / semrag_ask from aborting a legitimate run.
SEMRAG_MCP_TIMEOUT_SECONDS=7200
# How long semrag_index polls for a terminal job state (the /v1/.../index
# flow) before giving up. 1800s (30 min) covers a cold re-index.
SEMRAG_MCP_INDEX_MAX_WAIT_SECONDS=1800